# mcp/jev — jev-1.13-free (opencode-zen System One decision model) MCP server.
# Pure stdlib MCP (no pip deps).
#
# jev-1.13-free is reached ONLY at /zen/v1/systemone with a REAL API key + the
# desktop UA (opencode/1.18.31 + x-opencode-client: desktop). Anonymous/no-key ->
# 403 FreeTierError; bare key (no desktop UA) -> 403 error code 1010. No fallback
# to any other model — JEV_MODEL is fixed to jev-1.13-free.
#
# The opencode-zen key is NOT set here: mcp-jev reads the dev profile's
# OPENCODE_ZEN_API_KEY straight from ~/.hermes/profiles/dev/.env at runtime (Hermes
# does not inject profile secrets into MCP subprocesses). Never commit it.
JEV_MODEL=jev-1.13-free
JEV_ENDPOINT=https://opencode.ai/zen/v1/systemone
JEV_MCP=1          # on (default); set 0 to disable trimmer behaviour
JEV_DEBUG=0        # emit [jev-debug] POST/resp traces to stderr
