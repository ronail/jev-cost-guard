# mcp-jev environment
#
# mcp-jev targets the opencode-zen free tier (https://opencode.ai/zen/v1)
# by default. None of these are committed to the repo; set them in the
# shell that launches Hermes, or (preferably) rely on the dev profile's
# ~/.hermes/profiles/dev/.env, which the server reads directly for
# OPENCODE_ZEN_API_KEY (same credential the opencode-zen provider uses).

# Optional. Defaults to opencode-zen when unset (mcp-jev's purposes).
JEV_PROVIDER=opencode-zen

# Optional endpoint. Defaults to https://opencode.ai/zen/v1/chat/completions.
JEV_ENDPOINT=https://opencode.ai/zen/v1/chat/completions

# Free-tier model served by the opencode-zen relay.
JEV_MODEL=deepseek-v4.1-flash-free

# The API key. OPTIONAL here: if unset, mcp-jev reads OPENCODE_ZEN_API_KEY
# from ~/.hermes/profiles/dev/.env. Never commit a real key.
# JEV_API_KEY=<your-token>

# Opt into the model-driven compression path: jev-* skills call jev_summarize
# (instead of any slicing) when this is "1".
JEV_MCP=1

# Verbose relay/debug logging (prints key presence/path only, never values).
# JEV_DEBUG=1
