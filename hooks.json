{
  "jev-verdict": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"./hooks/antigravity-jev-verdict.py\"",
        "timeout": 30
      }
    ]
  },
  "jev-skill-hint": {
    "enabled": false,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"./hooks/antigravity-jev-route.py\"",
        "timeout": 15
      }
    ]
  },
  "jev-pretool-gate": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/pretool-gate.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "jev-post-tool": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"./hooks/claude-codex-jev-verdict.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
