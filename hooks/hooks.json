{
  "description": "jev gates: PostToolUse judges a large tool output and adds one advisory line (never replaces the payload); PreToolUse asks jev whether a shell command is routine, worth a human glance, or should be refused \u2014 audit mode by default, so it logs and never blocks until hooks/gate-policy.json says mode=enforce.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|exec|apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/claude-codex-jev-verdict.py\"",
            "statusMessage": "jev: judging tool output",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec|run_command|BashOutput",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/pretool-gate.py\"",
            "statusMessage": "jev: judging command risk",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
